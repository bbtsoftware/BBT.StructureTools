# (c) Copyright BBT Software AG
# Version 18.08.2025 13:30

# This is the top most settings file containing only the general rules.
# Apply project specific rules in the appropriate subfolder (eg. `src`, `test`, `doc` etc.)
root = true

# All files
[*]
guidelines = 180
max_line_length = 180

# editorconfig
[*.editorconfig]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Git files
[*.{gitignore, gitattributes}]
charset = utf-8
insert_final_newline = true

# bicep files
[*.bicep]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_size = 2
indent_style = space

# Xml project files
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj}]
charset = utf-8
indent_size = 2

# Xml config files
[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct,xml,xsc,xsd,xslt,xss,xsx,setings,stylecop}]
charset = utf-8
end_of_line = crlf
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Visual Studio Solution files
[*.{sln, slnx}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = tab

# JSON files
[*.json]
charset = utf-8-bom
end_of_line = crlf
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Cake scripts
[*.cake]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = space

# Powershell files
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = space

# Shell scripts
[*.sh]
charset = utf-8-bom
end_of_line = lf
indent_size = 2
indent_style = space

# Commandline scritps and batch files
[*.{cmd,bat}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = space

# T-SQL scripts
[*.sql]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space

# YAML pipeline files
[*.yaml]
charset = utf-8-bom
end_of_line = crlf
indent_size = 2
indent_style = space

# Markdown files
[*.md]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true

# ASPX und HTML files
[*.{aspx,htm,html}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
indent_style = space

# ASMX/ASAX files
[*.{aspx,asax,asmx}]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true

# CSS files
[*.{css,scss,less}]
charset = utf-8
end_of_line = crlf
indent_size = 2
indent_style = space


# --------------------------------------------------------------------------
# INFO: The definition for {*.cs,vb} code files must be placed at the end
#       in order for the following styling rules to take effect.
# --------------------------------------------------------------------------

# Code files
[*.{cs,vb}]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_size = 4
indent_style = space
trim_trailing_whitespace = true
file_header_template = Copyright (c) BBT Software AG. All Rights Reserved.


#
# STYLING RULES
# #####################################################################################################################

# XML comment analysis disabled
dotnet_diagnostic.SA0001.severity = none

# Invalid settings file (not set / default)
# dotnet_diagnostic.SA0002.severity = 

# Keywords should be spaced correctly
dotnet_diagnostic.SA1000.severity = warning

# Commas should be spaced correctly
dotnet_diagnostic.SA1001.severity = warning

# Semicolons should be spaced correctly
dotnet_diagnostic.SA1002.severity = warning

# Symbols should be spaced correctly
dotnet_diagnostic.SA1003.severity = warning

# Documentation lines should begin with single space
