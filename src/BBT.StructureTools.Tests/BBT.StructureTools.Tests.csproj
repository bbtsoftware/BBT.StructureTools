<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyTitle>BBT.StructureTools.Tests</AssemblyTitle>
    <Description>Tests for BBT.StructureTools</Description>
    <NoWarn>$(NoWarn);CA1008;CA1040;CA1062;CA1515;CA1707;CA1711;CA1725;CA1812;CA1852;CA2227;SA0001;SA1124;SA1201;SA1315;SA1518;SA1633</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="BBT.StrategyPattern" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Ninject" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBT.StructureTools.Extensions\BBT.StructureTools.Extensions.csproj" />
    <ProjectReference Include="..\BBT.StructureTools\BBT.StructureTools.csproj" />
  </ItemGroup>

</Project>
